{
  "manifest_version": 3,
  "name": "Roost — X bookmarks to Notion",
  "short_name": "Roost",
  "version": "1.0.0",
  "description": "Automatically archives your X (Twitter) bookmarks, threads and media into a Notion database, so nothing is lost if a post gets deleted.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "alarms", "cookies", "webRequest", "declarativeNetRequestWithHostAccess", "contextMenus", "notifications"],
  "host_permissions": ["https://x.com/*", "https://api.notion.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Roost",
    "default_popup": "ui/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_ui": { "page": "ui/options.html", "open_in_tab": true },
  "commands": {
    "save-current": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the X post in the current tab (with its thread) to Notion"
    }
  }
}
