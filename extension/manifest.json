{
  "manifest_version": 3,
  "name": "Trove — save anything",
  "short_name": "Trove",
  "version": "2.1.0",
  "description": "Save pages, links, images, highlights, browser bookmarks and your X bookmarks (with threads and media) to your Trove library in Notion.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "alarms", "cookies", "webRequest", "declarativeNetRequestWithHostAccess", "contextMenus", "notifications", "bookmarks", "scripting", "activeTab"],
  "host_permissions": ["https://x.com/*", "https://api.notion.com/*", "https://trove.mariomedpar.com/*", "https://www.youtube.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Save to Trove",
    "default_popup": "ui/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_ui": { "page": "ui/options.html", "open_in_tab": true },
  "commands": {
    "save-current": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the current page to Trove (X posts with their thread)"
    }
  }
}
